"""Build PSYC 105 Final Exam Anki deck (.apkg).

Generates one master deck "PSYC 105" with subdecks per the syllabus
chronology, plus ZAPS Demos and Mastery Questions subdecks.
"""

import genanki

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

BASIC_MODEL = genanki.Model(
    1607392319,
    "PSYC 105 Basic",
    fields=[{"name": "Front"}, {"name": "Back"}],
    templates=[
        {
            "name": "Card 1",
            "qfmt": "{{Front}}",
            "afmt": '{{FrontSide}}<hr id="answer">{{Back}}',
        }
    ],
    css=(
        ".card { font-family: -apple-system, Helvetica, Arial, sans-serif;"
        " font-size: 18px; color: #222; background: #fafafa; padding: 16px;"
        " line-height: 1.5; }"
        " hr#answer { margin: 16px 0; }"
        " b { color: #1a4480; }"
    ),
)

PARENT_DECK = "PSYC 105"

# Use unique deck IDs derived from a base
BASE_DECK_ID = 2059400110
deck_counter = [0]


def make_deck(name):
    deck_counter[0] += 1
    return genanki.Deck(BASE_DECK_ID + deck_counter[0], f"{PARENT_DECK}::{name}")


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def add_card(deck, front, back, tags):
    note = genanki.Note(
        model=BASIC_MODEL,
        fields=[front.replace("\n", "<br>"), back.replace("\n", "<br>")],
        tags=[t.replace(" ", "_") for t in tags],
    )
    deck.add_note(note)


def add_term(deck, term, definition, application, chapter_tag, section_tag):
    add_card(
        deck,
        f"<b>Term:</b> {term}",
        definition,
        [chapter_tag, section_tag, "definition"],
    )
    if application:
        add_card(
            deck,
            f"<b>High-Stakes Application of:</b> {term}",
            application,
            [chapter_tag, section_tag, "application"],
        )


def add_comparison(deck, title, text, chapter_tag, section_tag):
    add_card(
        deck,
        f"<b>Compare:</b> {title}",
        text,
        [chapter_tag, section_tag, "comparison"],
    )


def add_overview(deck, section_label, title, text, chapter_tag, section_tag):
    front = f"<b>Overview of Section {section_label}:</b> {title}" if section_label else f"<b>Overview:</b> {title}"
    add_card(deck, front, text, [chapter_tag, section_tag, "overview"])


def add_mastery(deck, label, question, answer, chapter_tag):
    add_card(
        deck,
        f"<b>Mastery Question — {label}</b><br><br>{question}",
        answer,
        [chapter_tag, "mastery"],
    )


def add_zaps(deck, title, week, chapter, concepts):
    front = f"<b>ZAPS Demo:</b> {title}"
    back = f"<b>Week:</b> {week}<br><b>Linked Chapter(s):</b> {chapter}<br><b>Key Concepts:</b> {concepts}"
    tags = ["zaps"]
    for ch in chapter.replace(" ", "").replace("Chapter", "Ch").split("+"):
        tags.append(ch.split(".")[0])
    add_card(deck, front, back, tags)


